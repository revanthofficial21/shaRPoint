# ── Clerk ─────────────────────────────────────────────
# Publishable key only. Safe to expose (it's public by design).
# Find it in Clerk Dashboard -> API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# ── Supabase ──────────────────────────────────────────
# Project URL and the anon/publishable key.
# Settings -> API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# ── AI backend (optional) ─────────────────────────────
# URL of a serverless function that proxies the Claude API.
# NEVER put an Anthropic API key in this file — anything prefixed
# VITE_ is bundled into the browser and is public.
VITE_AI_ENDPOINT=

# ── App ───────────────────────────────────────────────
VITE_APP_NAME=shaRPoint
VITE_APP_URL=http://localhost:3000
