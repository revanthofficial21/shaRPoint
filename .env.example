# ── Supabase (client-safe) ───────────────────────────────────────────────────
# Supabase Dashboard -> Settings -> API.
# The publishable / anon key is designed to be public; RLS is what protects data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── Accepted alternative names ───────────────────────────────────────────────
# Vite only exposes VITE_-prefixed variables to the browser. If your host is
# already configured with different names, the build resolves them automatically
# — you do not have to rename anything. The URL is read from the first of:
#
#   VITE_SUPABASE_URL, SUPABASE_URL, NEXT_PUBLIC_SUPABASE_URL
#
# and the key from the first of:
#
#   VITE_SUPABASE_ANON_KEY, SUPABASE_ANON_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#   SUPABASE_PUBLISHABLE_KEY, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#
# Only publishable values are ever considered. The build prints which variable
# name each value came from (never the value itself).

# ── Server-only secrets (NEVER prefix with VITE_) ────────────────────────────
# These belong in Supabase Edge Function secrets, not in this file.
#   supabase secrets set AI_API_KEY=... AI_PROVIDER=...
# SUPABASE_SERVICE_ROLE_KEY and SUPABASE_SECRET_KEY must never reach the browser
# and are deliberately NOT in the accepted-names lists above.
